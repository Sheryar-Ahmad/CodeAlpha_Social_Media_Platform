# Optional in development; npm run dev starts a persistent loopback MongoDB otherwise.
MONGODB_URI=
PORT=3002
APP_ORIGIN=http://127.0.0.1:5175
NODE_ENV=development
SEED_STARTER_CONTENT=true
# Set the exact proxy hop count only when deploying behind a trusted proxy.
TRUST_PROXY_HOPS=0
# Local previews are private files under .data/mail. Production requires a mail provider.
MAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Free hosting uses MAIL_MODE=brevo and a verified MAIL_FROM email address.
BREVO_API_KEY=
# Local development keeps photos on disk. Free hosting uses MEDIA_STORE=cloudinary.
MEDIA_STORE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
